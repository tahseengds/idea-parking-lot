# Copy to .env (or export these in your shell) — all are optional.

# --- AI (Fireworks AI, OpenAI-compatible) ---------------------------------
# Enables the Branch / Connect features. Get a key at https://fireworks.ai/
FIREWORKS_API_KEY=fw_...

# Optional overrides (sensible defaults shown):
# MODEL=accounts/fireworks/routers/kimi-k2p6-turbo
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# --- Storage --------------------------------------------------------------
# Local dev needs nothing — it uses a local SQLite file (./ideas.db).
#
# For deployment (e.g. Vercel), point at a libSQL/Turso database so data
# persists across serverless invocations. Create one at https://turso.tech/
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# --- Server ---------------------------------------------------------------
# PORT=3000
# DB_PATH=./ideas.db   # only used by the local SQLite backend
