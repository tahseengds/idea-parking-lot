# Copy to .env (or just export these in your shell) to enable AI features.

# Your Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-opus-4-8)
# MODEL=claude-sonnet-4-6

# Optional: port (defaults to 3000)
# PORT=3000

# Optional: where the SQLite file lives (defaults to ./ideas.db)
# DB_PATH=./ideas.db
